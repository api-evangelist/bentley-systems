{
  "opencollection": "1.0.0",
  "info": {
    "name": "iTwin Control Access Thumbnails API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://ims.bentley.com/connect/authorize",
      "accessTokenUrl": "https://ims.bentley.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Thumbnails",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Thumbnail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bentley.com/accesscontrol/:iModelId/thumbnail",
            "params": [
              {
                "name": "iModelId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Thumbnail"
        }
      ]
    }
  ],
  "bundled": true
}