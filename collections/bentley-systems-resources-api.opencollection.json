              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Resource"
        },
        {
          "info": {
            "name": "Get Resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bentley.com/accesscontrol/:scheduleId/resources/:resourceId",
