              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update ODATA"
        },
        {
          "info": {
            "name": "Delete ODATA",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bentley.com/accesscontrol/reporting/odata/:reportId",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete ODATA"
        }
      ]
    }
  ],
  "bundled": true
