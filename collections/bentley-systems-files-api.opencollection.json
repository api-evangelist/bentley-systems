{
  "opencollection": "1.0.0",
  "info": {
    "name": "iTwin Control Access Files API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://ims.bentley.com/connect/authorize",
      "accessTokenUrl": "https://ims.bentley.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bentley.com/accesscontrol/folders/:folderId/files",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Files"
        },
        {
          "info": {
            "name": "Create File",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bentley.com/accesscontrol/folders/:folderId/files",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create File"
        },
        {
          "info": {
            "name": "Get Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bentley.com/accesscontrol/files/:fileId",
            "params": [
              {
                "name": "fileId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Files"
        },
        {
          "info": {
            "name": "Update File",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.bentley.com/accesscontrol/files/:fileId",
            "params": [
              {
                "name": "fileId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update File"
        },
        {
          "info": {
            "name": "Delete File",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bentley.com/accesscontrol/files/:fileId",
            "params": [
              {
                "name": "fileId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete File"
        }
      ]
    }
  ],
  "bundled": true
}